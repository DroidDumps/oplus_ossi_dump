service neuralnetworks_hal_service_shim_mtk /vendor/bin/hw/android.hardware.neuralnetworks-shim-service-mtk-legacy-lazy
    interface aidl android.hardware.neuralnetworks.IDevice/mtk-neuron_shim

    class hal
    user system
    group system readproc
    task_profiles NNApiHALPerformance
    oneshot
    disabled

on post-fs-data
    mkdir /data/vendor/nn 0775 system system

on post-fs-data
    mkdir /data/vendor/nn/debug_plus 0775 system system
