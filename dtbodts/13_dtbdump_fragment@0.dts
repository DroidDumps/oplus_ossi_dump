	fragment@92 {
		target = <0xffffffff>;

		__overlay__ {

			ctp_tp_spi_mode {
				phandle = <0x34>;

				pins_cmd_dat {
					drive-strength = <0x2>;
					pinmux = <0x1c02 0x1a02 0x1b02 0x1902>;
				};
			};

			ctp_ts_cs_poweroff {
				phandle = <0x35>;

				pins_cmd_dat {
					bias-disable;
					output-low;
					pinmux = <0x1902>;
					slew-rate = <0x1>;
				};
			};

			ctp_ts_cs_poweron {
				phandle = <0x38>;

				pins_cmd_dat {
					drive-strength = <0x2>;
					pinmux = <0x1902>;
				};
			};

			ctp_ts_int_poweroff {
				phandle = <0x36>;

				pins_cmd_dat {
					bias-disable;
					output-low;
					pinmux = <0x100>;
					slew-rate = <0x1>;
				};
			};

			ctp_ts_int_poweron {
				phandle = <0x39>;

				pins_cmd_dat {
					bias-pull-up = <0x0>;
					input-enable;
					pinmux = <0x100>;
					slew-rate = <0x0>;
				};
			};

			ctp_ts_reset_poweroff {
				phandle = <0x37>;

				pins_cmd_dat {
					bias-disable;
					output-low;
					pinmux = <0x2200>;
					slew-rate = <0x1>;
				};
			};

			ctp_ts_reset_poweron {
				phandle = <0x3a>;

				pins_cmd_dat {
					bias-disable;
					output-high;
					pinmux = <0x2200>;
					slew-rate = <0x1>;
				};
			};
		};
	};

	fragment@93 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
