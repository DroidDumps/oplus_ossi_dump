	fragment@68 {
		target = <0xffffffff>;

		__overlay__ {

			ccdetect_active {
				phandle = <0x1c>;

				pins_cmd_dat {
					bias-pull-up;
					input-enable;
					pinmux = <0x2300>;
					slew-rate = <0x0>;
				};
			};

			ccdetect_sleep {
				phandle = <0x1d>;

				pins_cmd_dat {
					bias-pull-up;
					input-enable;
					pinmux = <0x2300>;
					slew-rate = <0x0>;
				};
			};

			charger_gpio_as_output_high {
				phandle = <0x19>;

				pins_cmd_dat {
					output-high;
					pinmux = <0x2100>;
					slew-rate = <0x1>;
				};
			};

			charger_gpio_as_output_low {
				phandle = <0x18>;

				pins_cmd_dat {
					output-low;
					pinmux = <0x2100>;
					slew-rate = <0x1>;
				};
			};

			dischg_disable {
				phandle = <0x1a>;

				pins_cmd_dat {
					output-low;
					pinmux = <0xa600>;
					slew-rate = <0x1>;
				};
			};

			dischg_enable {
				phandle = <0x1b>;

				pins_cmd_dat {
					output-high;
					pinmux = <0xa600>;
					slew-rate = <0x1>;
				};
			};

			eint0default {
				phandle = <0x17>;
			};

			sc6607_int_default {
				phandle = <0x1e>;

				pins_cmd_dat {
					bias-disable;
					input-enable;
					pinmux = <0x300>;
				};
			};

			splitchg_inter_active {
				phandle = <0x1f>;

				pins_cmd_dat {
					bias-pull-up;
					input-enable;
					pinmux = <0x300>;
				};
			};

			splitchg_inter_sleep {
				phandle = <0x20>;

				pins_cmd_dat {
					bias-pull-down;
					input-enable;
					pinmux = <0x300>;
				};
			};
		};
	};

