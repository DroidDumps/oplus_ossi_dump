<?xml version="1.0" encoding="utf-8"?>
<filter-conf>

    <version>2024091101</version>

    <filter-name>sys_preload_second_config_list</filter-name>
    <!-- policy switch -->
    <switchConfig
        dcsSwitch="true"
        ioAbilityOpen="true"
        ioBoostPreload="false"
        ioProfileGuidedPreload="true"
        nextAppPreloadSwitch="true"
        parallelAppPreloadSwitch="true"
        quickBootAppPreloadSwitch="true"
        sauAppPreload="true"
        vipAppPreloadSwitch="true"
        vipSdkAppPreloadSwitch="true" />

    <!-- preload 3.0 -->
    <iopgpThreshold
        mem12="50"
        mem6="50"
        mem8="50" />

    <ioOpenThreshold
        mem12="100"
        mem6="100"
        mem8="100" />

    <iopgpConfig
        appTraceThreshold="1"
        compilerTime="5000"
        thermalLevelThreshold="9"
        totalTraceThreshold="50" />

    <ioOpenSlot
        mem12="2"
        mem6="2"
        mem8="2" />

    <!-- share slot config -->
    <shareSlotMem6 sharedSlot="2" />

    <shareSlotMem8 sharedSlot="3" />

    <shareSlotMem12 sharedSlot="5" />

    <!-- isolate slot config, for special preload scene -->
    <isolateSlotMem6
        ioSlot="3"
        processSlot="3" />

    <isolateSlotMem8
        ioSlot="3"
        processSlot="3" />

    <isolateSlotMem12
        ioSlot="3"
        processSlot="3" />

    <!-- io pinner threshold -->
    <ioPinnerThreshold
        mem12="30"
        mem6="30"
        mem8="30" />

    <!-- memory threshold -->
    <memThreshold
        mem12="3072"
        mem6="2048"
        mem8="3072" />

    <!-- vipsdk config -->
    <vipSdkConfig
        appDiedCount="3"
        appDiedCountInDay="20"
        appDiedCountWithinTime="60000"
        crashStatSwitch="false"
        delayTime="1" />

    <vipSdkLevelMem6
        ioSlot="0"
        processSlot="2" />

    <vipSdkLevelMem8
        ioSlot="0"
        processSlot="2" />

    <vipSdkLevelMem12
        ioSlot="0"
        processSlot="2" />

    <!-- scene level(I, II, III) -->
    <!--<sceneLevelMem6 nextAppPreload="3"-->

    <!-- package level(I, II, III) -->
    <!--pkgLevel pkg="com.example.app" level="2"-->

    <!--black list pkg={pkgName} mask={sauAppPreload, parallelAppPreload, vipAppPreload, nextAppPreload}-->
    <blackList
        mask="0001"
        pkg="com.tencent.qqmusic" />

    <blackList
        mask="0001"
        pkg="com.hogezq.azsjgj" />

    <blackList
        mask="0001"
        pkg="com.tencent.android.qqdownloader" />

    <blackList
        mask="0001"
        pkg="com.tencent.mm" />

    <blackList
        mask="0001"
        pkg="com.kugou.android" />

    <blackList
        mask="0001"
        pkg="com.tencent.qqpim" />
    <!-- vip preload-->
    <blackList
        mask="0010"
        pkg="com.tencent.mm" />

    <!-- dynamic list pkg={pkgName} mask={sauAppPreload, parallelAppPreload, vipAppPreload, nextAppPreload}-->
    <dynamicList
        mask="0010"
        pkg="com.tencent.mm" />

    <!-- common Restriction-->
    <commonRestriction pkg="com.android.systemui" />

    <commonRestriction pkg="com.coloros.assistantscreen" />

    <commonRestriction pkg="com.oplus.secondaryhome" />

    <commonRestriction pkg="com.android.launcher" />
    <!-- callerpkg={pkgName} calleepkg={pkgName} cpnname={cpnname} action={aciton} mask={alarm，job, sync, provider, broadcast, service  }-->

    <!-- io boost slot manager-->
    <ioBoostConfig
        appTraceThreshold="1"
        ioBoostCompilerTime="20000"
        ioBoostLevelThreshold="200"
        ioBoostTimeout="400"
        thermalLevelThreshold="9"
        totalTraceThreshold="20" />

    <ioBoostSlot slot="20" />

    <ioBoostPkg pkg="com.whatsapp" />

    <ioBoostPkg pkg="com.facebook.katana" />

    <ioBoostPkg pkg="com.coloros.gallery3d" />

    <ioBoostPkg pkg="jp.naver.line.android" />

    <ioBoostPkg pkg="com.ss.android.ugc.trill" />

    <ioBoostPkg pkg="com.facebook.orca" />

    <ioBoostPkg pkg="com.android.chrome" />

    <ioBoostPkg pkg="com.google.android.youtube" />

    <ioBoostPkg pkg="com.instagram.android" />

    <ioBoostPkg pkg="com.google.android.googlequicksearchbox" />

    <ioBoostPkg pkg="com.zing.zalo" />

    <ioBoostPkg pkg="com.android.vending" />

    <ioBoostPkg pkg="com.facebook.orca" />

    <ioBoostPkg pkg="com.shopee.id" />

    <ioBoostPkg pkg="com.lazada.android" />

    <ioBoostPkg pkg="com.kasikorn.retail.mbanking.wap" />

    <ioBoostPkg pkg="com.lemon.lvoverseas" />

    <ioBoostPkg pkg="com.globe.gcash.android" />

    <ioBoostPkg pkg="com.scb.phone" />

    <ioBoostPkg pkg="ktbcs.netbank" />

    <!-- dexPreloadConfig -->
    <dexPreloadConfig
        switch="true"
        threshold="80" />

    <iopgpSystemPkg pkg="com.google.android.dialer" />

    <!-- usap switch config -->
    <usapSwitch switch="false" />

    <!-- preopen camera config -->
    <preOpenCamera switch="true" />
</filter-conf>
