{
    "24700":{
        "platform_config":{
            "sensor_arch":"mtk_sensor_arch_1_0"
        },
        "sensor_config":{
            "android.sensor.accelerometer":{
                "type":1,
                "support":"true",
                "module":"sc7a20|stk8xxx",
                "sc7a20":{
                    "mode":"batch_cali|factory_cali",
                    "offset_x": 0.0,
                    "offset_y": 0.0,
                    "offset_z": 0.0
                },
                "stk8xxx":{
                    "mode":"batch_cali|factory_cali",
                    "offset_x": 0.0,
                    "offset_y": 0.0,
                    "offset_z": 0.0
                }
            },
            "android.sensor.magnetic_field":{
                "type":2,
                "support":"true",
                "module":"mmc5603|mmc5617",
                "mmc5603":{
                    "mode":"batch_cali"
                },
                "mmc5617":{
                    "mode":"batch_cali"
                }
            },
            "android.sensor.gyroscope":{
                "type":4,
                "support":"true",
                "module": "module_ignore",
                "module_ignore": {
                    "mode": "virtual_sensor"
                }
            },
            "android.sensor.proximity":{
                "type":8,
                "support":"true",
                "module":"sip3515|sip3510",
                "sip3515":{
                    "mode":"ignore_mean|micro_gap|factory_cali",
                    "delta_threshold":150,
                    "ps0_offset": 0,
                    "ps0_distance_delta": 0,
                    "ps1_offset": 0,
                    "ps1_distance_delta": 0
                },
                "sip3510":{
                    "mode": "ignore_mean|micro_gap|factory_cali",
                    "delta_threshold": 150,
                    "ps0_offset": 0,
                    "ps0_distance_delta": 0,
                    "ps1_offset": 0,
                    "ps1_distance_delta": 0
                }
            },
            "android.sensor.step_counter":{
                "type":19,
                "support":"true"
            },
            "android.sensor.light":{
                "type":5,
                "support":"true",
                "module": "sip3515|sip3510",
                "sip3515": {
                    "mode": "factory_cali|micro_gap",
                    "cali_para": 1000
                },
                "sip3510":{
                    "mode":"factory_cali|micro_gap",
                    "cali_para": 1000
                }
            },
            "qti.sensor.rear_als":{
                "type":33171055,
                "support":"true",
                "module": "SIP1221LR1N",
                "SIP1221LR1N":{
                    "mode":"factory_cali",
                    "cali_para": 1000
                }
            },
            "qti.sensor.flicker_rear": {
                "type":33171054,
                "support":"true"
            }
        }
    }
}
