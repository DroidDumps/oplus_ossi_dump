<?xml version="1.0" encoding="utf-8"?>
<RFTOOLKIT>
    <TestCase mode="QtTest, Expert, Factory">
        <RAT name="GSM" pwrcheck="false">
            <Band type="Any">
                <Channel type="Mid">
                    <SubBand>0</SubBand>
                </Channel>
            </Band>
        </RAT>
    </TestCase>
    <TestCase mode="NPT">
        <RAT name="GSM" pwrcheck="false">
           <Band number="850,900,1800,1900">
                <Channel type="Low">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna><!-- TX ANT1 & ANT0 -->
                </Channel>
                <Channel type="Mid">
                     <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna> <!-- TX ANT1 & ANT0 -->
                </Channel>
                <Channel type="High">
                    <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna><!-- TX ANT1 & ANT0 -->
                </Channel>
            </Band>
        </RAT>
        <RAT name="WCDMA">
           <Band number="1,2,4,5,8">
                <Channel type="Mid">
                     <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna> <!-- TX ANT1 & ANT0 -->
                </Channel>
            </Band>
        </RAT>
        <RAT name="LTE">
            <Band number="1,2,3,4,5,7,8,13,20,26,28,38,40,41,66">
                <Channel type="Mid">
                     <SubBand>0</SubBand>
                     <Antenna paIndex="0"> 0,101 </Antenna>
                </Channel>
            </Band>
        </RAT>
    </TestCase>
</RFTOOLKIT>
